# NatoDark Studio — copie para backend/.env (NUNCA commite o .env)
# Os mesmos nomes valem como Secrets do Worker Cloudflare.

# Router de IA (ordem: gemini -> nvidia -> groq -> openrouter -> cloudflare -> openai -> anthropic -> ollama)
SCRIPT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
# Alias aceito (se você usou este nome na Cloudflare):
OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama: sem chave = local; com chave = Ollama Cloud
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1

# awesome-free-llm-apis — 3 aprovados sem chave (ja entram no router automaticamente)
# KILOCODE_MODEL=kilo-auto/free
# LLM7_MODEL=gpt-oss:20b
# OVH_MODEL=Meta-Llama-3_3-70B-Instruct
# Demais (opcionais, so entram se a chave existir):
AION_API_KEY=
AXFORGE_API_KEY=
ZAI_API_KEY=
GONKA_API_KEY=
MODELSCOPE_API_KEY=
SILICONFLOW_API_KEY=
COHERE_API_KEY=
LLM7_API_KEY=

# Mídia gratuita (Pexels/Pixabay precisam de conta; Openverse e Wikimedia, não)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcionais
YOUTUBE_API_KEY=
HF_TOKEN=
APP_URL=http://localhost:3000

# Whisper local (fica no computador; voz não sai da máquina)
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=pt
