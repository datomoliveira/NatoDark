# NatoDark Studio — copie para backend/.env (NUNCA commite o .env)
# Os mesmos nomes valem como Secrets do Worker Cloudflare.

# Router de IA (ordem: gemini -> nvidia -> groq -> openrouter -> cloudflare -> openai -> anthropic -> ollama)
SCRIPT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
# Alias aceito (se você usou este nome na Cloudflare):
OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama: sem chave = local; com chave = Ollama Cloud
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1

# Mídia gratuita (Pexels/Pixabay precisam de conta; Openverse e Wikimedia, não)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcionais
YOUTUBE_API_KEY=
HF_TOKEN=
APP_URL=http://localhost:3000

# Whisper local (fica no computador; voz não sai da máquina)
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=pt
