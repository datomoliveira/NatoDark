# ============================================================
# NatoDark — copie para .env e preencha
# No Worker da Cloudflare, estas MESMAS variaveis sao os Secrets:
#   wrangler secret put GEMINI_API_KEY
# ============================================================

# Router de modelos — "auto" escolhe o primeiro provedor configurado nesta ordem:
# gemini -> groq -> openrouter -> cloudflare -> openai -> anthropic -> ollama
SCRIPT_PROVIDER=auto
# SCRIPT_MODEL=                 # opcional: fixa um modelo para qualquer provedor

# 1) Gemini — GRATUITO, sem cartao — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alternativa mais leve: gemini-3.5-flash-lite

# 2) Groq — GRATUITO — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3) OpenRouter — modelos ":free" — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4) Cloudflare Workers AI — GRATUITO
# Account ID + API Token com permissao "Workers AI - Edit"
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# 5) OpenAI — PAGO, barato
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 6) Anthropic — PAGO, opcional
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 7) Ollama local — GRATUITO, sem chave, so no computador
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# Mídia automática — chaves GRATUITAS (aumentam muito a qualidade)
# Pexels: https://www.pexels.com/api/  |  Pixabay: https://pixabay.com/api/docs/
# Unsplash: https://unsplash.com/developers -> "New Application" -> Access Key
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Sem essas chaves, o sistema usa Openverse/Wikimedia (sem chave) e slides locais.

# Legendas sincronizadas com a SUA VOZ — faster-whisper (roda LOCAL, sem custo)
# O modelo e baixado uma vez (~500MB para "small") e fica em cache.
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
WHISPER_COMPUTE=int8         # int8 (CPU) | float16 (GPU)
WHISPER_LANGUAGE=pt
# HF_TOKEN=                  # opcional: so para cota/velocidade no download do modelo

# YouTube Data API v3 — OPCIONAL. Usada como alternativa e para ANALISE dos seus
# videos (metadados, comentarios, canal). A pesquisa de hype usa HTML/navegador
# sem chave e sem cota — e e a via principal. A API NAO traz grafico de retencao.
# YOUTUBE_API_KEY=

# Opcional: Backblaze B2 (sem isso o storage usa pasta local)
# B2_ENDPOINT=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=

# Opcional: protege as rotas /api do Worker da Cloudflare
# API_TOKEN=
